#!/bin/bash

export ROOT=$(echo $ROOT | grep . || pwd)
export NCORES=`nproc --all`

while getopts ":ih" opt; do
  case ${opt} in
    i )
        export BUILD_IMAGE="1"
        ;;
    h ) echo "Usage: ./BuildLinuxImage.sh [-i]"
        echo "   -i: Generate Appimage (optional)"
        exit 0
        ;;
  esac
done

echo -n "[9/9] Generating Linux app..."
#{
    # create directory and copy into it
    if [ -d "package" ]
    then
        rm -rf package/*
        rm -rf package/.* 2&>/dev/null
    else
        mkdir package
    fi
    mkdir package/bin

    # copy Resources
    cp -Rf ../resources package/resources
    #llvm-strip --strip-debug src/@SLIC3R_APP_CMD@
    cp -f src/@SLIC3R_APP_CMD@ package/bin/@SLIC3R_APP_CMD@
    # remove unneeded po from resources
    ## find package/resources/localization -name "*.po" -type f -delete ## FIXME: DD - do we need this?

    # create bin
cat << EOF >@SLIC3R_APP_CMD@
#!/bin/bash
DIR=\$(readlink -f "\$0" | xargs dirname)
export LD_LIBRARY_PATH="\$DIR/bin:\$DIR/usr/lib"

# libOpenGL.so.0 / libGLX.so.0 / libGLdispatch.so.0 (libglvnd's dispatch
# libraries) are bundled separately in usr/lib-gl-fallback/, kept out of
# the LD_LIBRARY_PATH above, so a host that already has any of them keeps
# using its own (correctly driver-matched) copy. Only fall back to our
# bundled copy of a given library - and only that one, per-library, via
# a throwaway symlink dir, so we never shadow a host copy of a *different*
# library that happens to already be present - when the host is missing
# it entirely, which otherwise makes the app fail to even start with
# "error while loading shared libraries: libOpenGL.so.0".
GL_FALLBACK_DIR=""
for lib in libOpenGL.so.0 libGLX.so.0 libGLdispatch.so.0; do
    if [ -f "\$DIR/usr/lib-gl-fallback/\$lib" ] && ! ldconfig -p 2>/dev/null | grep -q "\$lib "; then
        if [ -z "\$GL_FALLBACK_DIR" ]; then
            GL_FALLBACK_DIR=\$(mktemp -d)
            trap 'rm -rf "\$GL_FALLBACK_DIR"' EXIT
        fi
        ln -sf "\$DIR/usr/lib-gl-fallback/\$lib" "\$GL_FALLBACK_DIR/\$lib"
    fi
done
if [ -n "\$GL_FALLBACK_DIR" ]; then
    export LD_LIBRARY_PATH="\$LD_LIBRARY_PATH:\$GL_FALLBACK_DIR"
fi

# FIXME: CrealityPrint segfault workarounds
# 1) CrealityPrint will segfault on systems where locale info is not as expected (i.e. Holo-ISO arch-based distro)
export LC_ALL=C
# 2) GTK3/WebKitGTK in this app are not reliable on native Wayland (WebView
# creation fails with "Gdk-Message: Error 22 dispatching to Wayland
# display" and the process exits) but work fine through XWayland. Force
# x11 unless the user explicitly set GDK_BACKEND themselves.
export GDK_BACKEND="\${GDK_BACKEND:-x11}"

exec "\$DIR/bin/@SLIC3R_APP_CMD@" "\$@"
EOF

    chmod ug+x @SLIC3R_APP_CMD@
    cp -f @SLIC3R_APP_CMD@ package/@SLIC3R_APP_CMD@
    pushd package
    tar -cvf ../@SLIC3R_APP_KEY@.tar .  &>/dev/null
    popd
#} &> $ROOT/Build.log # Capture all command output
echo "done"

if [[ -n "$BUILD_IMAGE" ]]
then
echo -n "Creating Appimage for distribution..."
#{
    pushd package
    chmod +x ../build_appimage.sh
    ../build_appimage.sh
    popd
    mv package/"@SLIC3R_APP_NAME@-V@CREALITYPRINT_VERSION@-x86_64-@PROJECT_VERSION_EXTRA@.AppImage" "@SLIC3R_APP_NAME@-V@CREALITYPRINT_VERSION@-x86_64-@PROJECT_VERSION_EXTRA@.AppImage"
#} &> $ROOT/Build.log # Capture all command output
echo "done"
fi
